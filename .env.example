# Postgres (Docker Compose)
POSTGRES_USER=mgnovenie
POSTGRES_PASSWORD=mgnovenie
POSTGRES_DB=mgnovenie

# Nuxt runtimeConfig — maps to runtimeConfig.databaseUrl / public.siteUrl
NUXT_DATABASE_URL=postgresql://mgnovenie:mgnovenie@localhost:5432/mgnovenie
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional order notifications (NUXT_TELEGRAM_BOT_TOKEN / NUXT_TELEGRAM_CHAT_ID)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Phase 2 — T-Bank Acquiring
NUXT_TBANK_TERMINAL_KEY=
NUXT_TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=
